# All settings are optional; defaults are shown. Copy to backend/.env to override.
# EMOVISION_DEVICE=auto            # auto | cpu | cuda
# EMOVISION_MAX_UPLOAD_BYTES=2097152
# EMOVISION_MAX_FACES=3
# EMOVISION_FACE_SCORE_THRESHOLD=0.7
# EMOVISION_DETECTION_MAX_SIDE=960
# EMOVISION_RECOMMENDED_INTERVAL_MS=700
# JSON list of allowed browser origins (keep this narrow):
# EMOVISION_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
